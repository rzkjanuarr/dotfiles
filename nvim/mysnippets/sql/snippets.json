  "FILTER_ASC_DESC": {
    "prefix": "FILTER_ASC_DESC",
    "body": [
      "### SECTION ORDER BY",
      "# ORDER BY ASC -> TERKECIL",
      "# ORDER BY DESC -> TERBESAR",
      "SELECT *",
      "FROM ${table_name}",
      "ORDER BY",
      "    ${column_name} ASC,",
      "    ${id_column} DESC",
      "LIMIT ${limit_number}",
      ";",
      "",
      "SELECT ${table_alias}.name     AS NAMA,",
      "       ${table_alias}.category AS KATEGORI,",
      "       ${table_alias}.price    AS HARGA,",
      "       ${table_alias}.quantity AS STOCK",
      "FROM ${table_name} AS ${table_alias};"
    ],
    "description": "Filter data dengan ORDER BY (ASC/DESC) dan LIMIT",
    "scope": "sql"
  },
  "SELECT_ALL": {
    "prefix": "SELECT_ALL",
    "body": [
      "SELECT *",
      "FROM ${table_name};",
      "",
      "SELECT",
      "    ${column_name} AS nama,",
      "    ${price_column} AS harga,",
      "    ${quantity_column} AS sisa",
      "FROM ${table_name};"
    ],
    "description": "Melihat semua atau beberapa data dari tabel",
    "scope": "sql"
  },
  "FILTER_AVG": {
    "prefix": "FILTER_AVG",
    "body": [
      "# AVG(price) - Menghitung rata-rata harga",
      "SELECT AVG(${column_name}) AS '${alias_name}'",
      "FROM ${table_name};"
    ],
    "description": "Menghitung rata-rata kolom",
    "scope": "sql"
  },
  "FILTER_AVG_SUM_MIN_MAX": {
    "prefix": "FILTER_AVG_SUM_MIN_MAX",
    "body": [
      "### SECTION GROUP BY",
      "SELECT COUNT(${id_column}) AS '${count_alias}',",
      "       ${group_column}",
      "FROM ${table_name}",
      "GROUP BY ${group_column};",
      "",
      "SELECT MAX(${price_column}) AS '${max_alias}',",
      "       ${group_column}",
      "FROM ${table_name}",
      "GROUP BY ${group_column};",
      "",
      "SELECT MIN(${price_column}) AS '${min_alias}',",
      "       ${group_column}",
      "FROM ${table_name}",
      "GROUP BY ${group_column};",
      "",
      "SELECT AVG(${price_column}) AS '${avg_alias}',",
      "       ${group_column}",
      "FROM ${table_name}",
      "GROUP BY ${group_column};",
      "",
      "SELECT SUM(${quantity_column}) AS '${sum_alias}',",
      "       ${group_column}",
      "FROM ${table_name}",
      "GROUP BY ${group_column};",
      "",
      "### SECTION HAVING CLAUSE",
      "SELECT COUNT(${id_column}) AS ${total_alias},",
      "       ${group_column}",
      "FROM ${table_name}",
      "GROUP BY ${group_column}",
      "HAVING ${total_alias} > ${min_count};"
    ],
    "description": "Contoh GROUP BY dan HAVING dengan agregasi (COUNT, MAX, MIN, AVG, SUM)",
    "scope": "sql"
  },
  "FILTER_BEETWEN": {
    "prefix": "FILTER_BEETWEN",
    "body": [
      "# BETWEEN OPERATOR",
      "# KADANG KITA INGIN LANGSUNG MENCARI DATA >= dan <= SECARA SEKALIGUS",
      "# Misal mencari data products yang harganya antara 10000 sampai 20000",
      "# Untuk melakukan itu, kita bisa menggunakan \" WHERE price >= 10000 AND price <= 20000 \"",
      "# Namun ada operator BETWEEN yang bisa kita gunakan secara sederhana",
      "# Untuk kebalikannya, kita bisa gunakan NOT BETWEEN",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} BETWEEN ${min_value} AND ${max_value};",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} NOT BETWEEN ${min_value} AND ${max_value};"
    ],
    "description": "Filter data dengan operator BETWEEN dan NOT BETWEEN",
    "scope": "sql"
  },
  "FILTER_COUNT": {
    "prefix": "FILTER_COUNT",
    "body": [
      "# COUNT(id) - Menghitung total baris data",
      "SELECT COUNT(${id_column}) AS '${count_alias}'",
      "FROM ${table_name};"
    ],
    "description": "Menghitung total baris data",
    "scope": "sql"
  },
  "FILTER_LIKE": {
    "prefix": "FILTER_LIKE",
    "body": [
      "select *",
      "from ${table_name};",
      "# MENCARI STRING DENGAN AWALAN S",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} LIKE '${prefix}%';",
      "",
      "# MENCARI STRING DENGAN AKHIRAN D",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} LIKE '%${suffix}';",
      "",
      "# MENCARI STRING BERISI MILD",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} LIKE '%${contains}%';"
    ],
    "description": "Filter data dengan operator LIKE",
    "scope": "sql"
  },
  "FILTER_MAX": {
    "prefix": "FILTER_MAX",
    "body": [
      "# MAX(price) - Mencari harga tertinggi",
      "SELECT MAX(${column_name}) AS '${max_alias}'",
      "FROM ${table_name};"
    ],
    "description": "Menghitung nilai maksimum dari kolom",
    "scope": "sql"
  },
  "FILTER_MIN": {
    "prefix": "FILTER_MIN",
    "body": [
      "# MIN(price) - Mencari harga terendah",
      "SELECT MIN(${column_name}) AS '${min_alias}'",
      "FROM ${table_name};"
    ],
    "description": "Menghitung nilai minimum dari kolom",
    "scope": "sql"
  },
  "FILTER_NOT_IN": {
    "prefix": "FILTER_NOT_IN",
    "body": [
      "# OPERATOR IN",
      "# IN DIGUNAKAN UNTUK MEMPERSINGKAT DARI OPERATOR OR",
      "",
      "# AWALANYA KAYAK GINI",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} = '${value1}'",
      "   OR ${column_name} = '${value2}';",
      "",
      "# JADI KAYAK GINI",
      "# IN",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} IN ('${value1}', '${value2}');",
      "",
      "# NOT IN",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} NOT IN ('${value1}', '${value2}');"
    ],
    "description": "Filter data dengan operator IN dan NOT IN",
    "scope": "sql"
  },
  "FILTER_NULL_IS_NULL": {
    "prefix": "FILTER_NULL_IS_NULL",
    "body": [
      "# NULL OPERATOR",
      "# IS NULL -> Mencari yang NULL",
      "# IS NOT NULL -> Mencari yang tidak NULL",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} IS NULL;",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} IS NOT NULL;"
    ],
    "description": "Filter data dengan operator IS NULL dan IS NOT NULL",
    "scope": "sql"
  },
  "FILTER_OPERATOR": {
    "prefix": "FILTER_OPERATOR",
    "body": [
      "# MELIHAT SEMUA DATA QUANTITY YANG LEBIH DARI 50",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${quantity_column} > ${min_quantity};",
      "",
      "# MELIHAT SEMUA DATA QUANTITY YANG LEBIH DARI SAMA DENGAN 50",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${quantity_column} >= ${min_quantity};",
      "",
      "# MELIHAT SEMUA DATA YANG TIDAK SAMA DENGAN CATEGORY KRETEK",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${category_column} != '${category_value}';",
      "",
      "# MELIHAT SEMUA DATA YANG TIDAK SAMA DENGAN CATEGORY KRETEK",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${category_column} <> '${category_value}';",
      "",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${quantity_column} > ${min_quantity}",
      "  AND ${price_column} > ${min_price};",
      "",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${category_column} = '${category_value}'",
      "  AND ${price_column} < ${max_price};",
      "",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${quantity_column} > ${min_quantity}",
      "   OR ${price_column} > ${min_price};",
      "",
      "# OR",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE (${category_column} = '${category_value}' OR ${quantity_column} > ${min_quantity})",
      "  AND ${price_column} > ${min_price};"
    ],
    "description": "Filter data dengan operator perbandingan (>, >=, !=, <>, AND, OR)",
    "scope": "sql"
  },
  "FILTER_STOCK_QUANTITY": {
    "prefix": "FILTER_STOCK_QUANTITY",
    "body": [
      "# MENCARI SEMUA DATA PRODUK FILTER DENGAN QUANTITY 100",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${quantity_column} = ${quantity_value};",
      "",
      "# MENCARI BEBERAPA DATA PRODUK FILTER DENGAN QUANTITY 100",
