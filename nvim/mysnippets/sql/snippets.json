  "JOIN_INNER": {
    "prefix": "JOIN_INNER",
    "body": [
      "# - Jika ingin menampilkan data dari dua relasi table yang tetap tidak ada datanya atau NULL.",
      "#     Kita bisa pakai antara RIGHT JOIN DAN LEFT JOIN.",
      "# - Jika ingin menampilkan data dari dua relasi table yang ada datanya atau NOT NULLABLE, kita bisa pakai INNER JOIN",
      "# - Jika ingin menampilkan data dari dua relasi table yang hanya tidak ada datanya atau NULLABLE.",
      "#     Kita bisa pakai LEFT JOIN dan WHERE IS NULL",
      "SELECT ${user_table}.id      AS `Id User`,",
      "       ${user_table}.name    AS `Nama User`,",
      "       ${post_table}.title   AS `Title Post`,",
      "       ${post_table}.content AS `Content Post`",
      "FROM ${users_table} AS ${user_table}",
      "         INNER JOIN ${posts_table} AS ${post_table} ON ${user_table}.id = ${post_table}.user_id;"
    ],
    "description": "INNER JOIN untuk menampilkan data yang cocok dari dua tabel",
    "scope": "sql"
  },
  "JOIN_LEFT": {
    "prefix": "JOIN_LEFT",
    "body": [
      "# - Jika ingin menampilkan data dari dua relasi table yang tetap tidak ada datanya atau NULL.",
      "#     Kita bisa pakai antara RIGHT JOIN DAN LEFT JOIN.",
      "# - Jika ingin menampilkan data dari dua relasi table yang ada datanya atau NOT NULLABLE, kita bisa pakai INNER JOIN",
      "# - Jika ingin menampilkan data dari dua relasi table yang hanya tidak ada datanya atau NULLABLE.",
      "#     Kita bisa pakai LEFT JOIN dan WHERE IS NULL",
      "SELECT ${user_table}.id      AS `ID USER`,",
      "       ${user_table}.name    AS `NAME USER`,",
      "       ${post_table}.title   AS `TITLE POST`,",
      "       ${post_table}.content AS `CONTENT POST`",
      "FROM ${users_table} ${user_table}",
      "         LEFT JOIN ${posts_table} ${post_table} ON ${user_table}.id = ${post_table}.user_id;"
    ],
    "description": "LEFT JOIN untuk menampilkan semua data dari tabel kiri",
    "scope": "sql"
  },
  "JOIN_RIGHT": {
    "prefix": "JOIN_RIGHT",
    "body": [
      "# - Jika ingin menampilkan data dari dua relasi table yang tetap tidak ada datanya atau NULL.",
      "#     Kita bisa pakai antara RIGHT JOIN DAN LEFT JOIN.",
      "# - Jika ingin menampilkan data dari dua relasi table yang ada datanya atau NOT NULLABLE, kita bisa pakai INNER JOIN",
      "# - Jika ingin menampilkan data dari dua relasi table yang hanya tidak ada datanya atau NULLABLE.",
      "#     Kita bisa pakai LEFT JOIN dan WHERE IS NULL",
      "SELECT ${user_table}.id      AS `ID USER`,",
      "       ${user_table}.name    AS `NAME USER`,",
      "       ${post_table}.title   AS `TITLE POST`,",
      "       ${post_table}.content AS `CONTENT POST`",
      "FROM ${users_table} ${user_table}",
      "         RIGHT JOIN ${posts_table} ${post_table} ON ${user_table}.id = ${post_table}.user_id;"
    ],
    "description": "RIGHT JOIN untuk menampilkan semua data dari tabel kanan",
    "scope": "sql"
  },
  "REPLACE_LOWER_UPPER_LENGTH": {
    "prefix": "REPLACE_LOWER_UPPER_LENGTH",
    "body": [
      "SELECT LOWER(${column_name})  AS '${lower_alias}',",
      "       UPPER(${column_name})  AS '${upper_alias}',",
      "       LENGTH(${column_name}) AS '${length_alias}'",
      "FROM ${table_name};"
    ],
    "description": "Mengubah case, mencari panjang string, dan mengganti teks",
    "scope": "sql"
  },
