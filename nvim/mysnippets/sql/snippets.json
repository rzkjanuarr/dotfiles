      "    ${name_column} AS nama,",
      "    ${price_column} AS harga",
      "FROM ${table_name}",
      "WHERE ${quantity_column} = ${quantity_value};",
      "",
      "# MENCARI SEMUA DATA PRODUK FILTER DENGAN PRICE 15000",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${price_column} = ${price_value};",
      "",
      "# MENCARI BEBERAPA DATA PRODUK FILTER DENGAN PRICE 15000",
      "SELECT ",
      "    ${name_column} AS nama,",
      "    ${price_column} AS harga",
      "FROM ${table_name}",
      "WHERE ${price_column} = ${price_value};"
    ],
    "description": "Filter data berdasarkan kuantitas atau harga",
    "scope": "sql"
  },
