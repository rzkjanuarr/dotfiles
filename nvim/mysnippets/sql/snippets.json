      "ALTER TABLE ${table_name}",
      "    ADD COLUMN ${new_column} ${column_type}",
      "        AFTER ${after_column};"
    ],
    "description": "Menambah kolom baru ke tabel",
    "scope": "sql"
  },
  "TABLE_ADD_COLUMN_CREATED_AT": {
    "prefix": "TABLE_ADD_COLUMN_CREATED_AT",
    "body": [
      "ALTER TABLE ${table_name}",
      "    ADD COLUMN created_at",
      "        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP;"
    ],
    "description": "Menambah kolom `created_at` dengan timestamp otomatis",
    "scope": "sql"
  },
  "TABLE_ADD_COLUMN_INDEX": {
    "prefix": "TABLE_ADD_COLUMN_INDEX",
    "body": [
      "ALTER TABLE ${table_name}",
      "    ADD INDEX ${index_name} (${column_name});",
      "    ",
      "    # CONTOH ADA 100 DATA ketika pake indexing totalnya analyze 0.3 detik, jika tidak pake indexing 0.11 detik",
      "SELECT *",
      "FROM ${table_name}",
      "WHERE ${column_name} = '${search_value}';",
      "",
      "# CARA KERJA TANPA INDEXING",
      "# - DATABASE HARUS MELAKUKAN FULL TABLE SCAN",
      "# - HARUS MEMERIKSA SETIAP BARIS DARI 1 JUTA DATA",
      "# - WAKTU PENCARIAAN BISA SANGAT LAMA (5-10 DETIK)",
      "# - SEPERTI MENCARI BUKU DI PERPUSTAKAAN TANPA SISTEM PENOMORAN, ANDA HARUS MEMERIKSA SETIAP RAK SATU PER SATU",
      "",
      "# CARA KERJA DENGAN INDEXING",
      "# - DATABASE LANGSUNG MENUJU KE LOKASI DATA YANG DICARI",
      "# - TIDAK PERLU MEMERIKSA SELURUH TABLE",
      "# - WAKTU PENCARIAN SANGAT CEPAT (MISALNYA 0.1 DETIK)",
      "# - SEPERTI MENCARI BUKU MENGGUNAKAN KATALOG PERPUSTAKAAN, ANDA LANGSUNG TAHU DI RAK MANA BUKU TERSEBUT BERADA"
    ],
    "description": "Menambah indeks pada kolom tabel dan penjelasan manfaat indeks",
    "scope": "sql"
  },
  "TABLE_ALIAS_COLUMN": {
    "prefix": "TABLE_ALIAS_COLUMN",
    "body": [
      "# MENAMPILKAN SEMUA DATA",
      "SELECT *",
      "FROM ${table_name};",
      "",
      "# MENAMPILKAN BEBERAPA DATA",
      "SELECT ${name_column},",
      "       ${category_column},",
      "       ${price_column},",
      "       ${quantity_column}",
      "FROM ${table_name};",
      "",
      "# MENAMPILKAN BEBERAPA DATA DENGAN ALIAS (COLUMN)",
      "SELECT ${name_column}     AS NAMA,",
      "       ${category_column} AS KATEGORI,",
      "       ${price_column}    AS HARGA,",
      "       ${quantity_column} AS STOCK",
      "FROM ${table_name};",
      "",
      "# MENAMPILKAN BEBERAPA DATA DENGAN ALIAS (TABLE)",
      "SELECT ${table_alias}.name     AS NAMA,",
      "       ${table_alias}.category AS KATEGORI,",
      "       ${table_alias}.price    AS HARGA,",
      "       ${table_alias}.quantity AS STOCK",
      "FROM ${table_name} AS ${table_alias};"
    ],
    "description": "Menggunakan alias untuk kolom dan tabel",
    "scope": "sql"
  },
  "TABLE_CREATE": {
    "prefix": "TABLE_CREATE",
    "body": [
      "CREATE TABLE ${table_name}",
      "(",
      "    ${id_column}        INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,",
      "#     id     CHAR PRIMARY KEY DEFAULT uuid(),",
      "    ${name_column}      VARCHAR(255),",
      "    ${price_column}     DECIMAL(10, 2) UNSIGNED DEFAULT 0.00,",
      "    ${quantity_column}    INT UNSIGNED            DEFAULT 0,",
      "    ${available_column}  BOOLEAN                 DEFAULT TRUE,",
      "    ${category_column}  ENUM ('elektronik', 'pakaian', 'makanan', 'lainnya') NOT NULL,",
      "    ${description_column} TEXT                                                 NULL,",
      "    ${created_at_column} TIMESTAMP                                            NOT NULL DEFAULT CURRENT_TIMESTAMP",
      ") ENGINE = InnoDB;"
    ],
    "description": "Membuat tabel baru",
    "scope": "sql"
  },
  "TABLE_CREATE_INDEX": {
    "prefix": "TABLE_CREATE_INDEX",
    "body": [
      "CREATE TABLE ${table_name}",
      "(",
      "    ${id_column}         INT PRIMARY KEY AUTO_INCREMENT,",
      "    ${name_column}       VARCHAR(100) NOT NULL,",
      "    ${email_column}      VARCHAR(100) NOT NULL,",
      "    ${department_column} VARCHAR(100) NULL,",
      "    INDEX ${index_name} (${email_column})",
      ") ENGINE = InnoDB;"
    ],
    "description": "Membuat tabel dengan indeks",
    "scope": "sql"
  },
  "TABLE_CREATE_RELATIONSHIP": {
    "prefix": "TABLE_CREATE_RELATIONSHIP",
    "body": [
      "CREATE TABLE ${table_name}",
      "(",
      "    ${id_column}          INT  NOT NULL PRIMARY KEY AUTO_INCREMENT,",
      "    ${product_id_column}  INT  NOT NULL,",
      "    ${description_column} TEXT NULL,",
      "    FOREIGN KEY (${product_id_column}) REFERENCES ${products_table} (${id_column}) ON DELETE CASCADE",
      ") ENGINE = InnoDB;"
    ],
    "description": "Membuat tabel dengan foreign key",
    "scope": "sql"
  },
  "TABLE_CREATE_RELATIONSHIP_MANY_TO_MANY": {
    "prefix": "TABLE_CREATE_RELATIONSHIP_MANY_TO_MANY",
    "body": [
      "CREATE TABLE ${students_table}",
      "(",
      "    ${id_column}   INT PRIMARY KEY AUTO_INCREMENT,",
      "    ${name_column} VARCHAR(100) NOT NULL",
      ") ENGINE = InnoDB;",
      "",
      "CREATE TABLE ${courses_table}",
      "(",
      "    ${id_column}          INT PRIMARY KEY AUTO_INCREMENT,",
      "    ${course_name_column} VARCHAR(100) NOT NULL",
      ") ENGINE = InnoDB;",
      "",
      "CREATE TABLE ${student_courses_table}",
      "(",
      "    ${student_id_column} INT NOT NULL,",
      "    ${course_id_column}  INT NOT NULL,",
      "    PRIMARY KEY (${student_id_column}, ${course_id_column}),",
      "    FOREIGN KEY (${student_id_column}) REFERENCES ${students_table} (${id_column}) ON DELETE CASCADE,",
      "    FOREIGN KEY (${course_id_column}) REFERENCES ${courses_table} (${id_column}) ON DELETE CASCADE",
      ") ENGINE = InnoDB;"
    ],
    "description": "Membuat tabel untuk relasi many-to-many",
    "scope": "sql"
  },
  "TABLE_DATA_DELETE": {
    "prefix": "TABLE_DATA_DELETE",
    "body": [
      "DELETE",
      "FROM ${table_name}",
      "WHERE ${id_column} = ${id_value};"
    ],
    "description": "Menghapus data dari tabel",
    "scope": "sql"
  },
  "TABLE_DESCRIBE_1": {
    "prefix": "TABLE_DESCRIBE_1",
    "body": [
