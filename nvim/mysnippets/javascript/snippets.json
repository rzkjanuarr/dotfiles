  "button-telp": {
    "description": "Saved from visual selection",
    "prefix": "button-telp",
    "body": [
      "const makeCall = async () => {",
      "    const phoneNumber = '085749463854';",
      "    const URL = `tel:${phoneNumber}`;",
      "    const supportedURL = await Linking.canOpenURL(URL);",
