{
  "textInput2-multiline": {
    "description": "Saved from visual selection",
    "body": [
      "<TextInput",
      "        style={{",
      "          borderWidth: 1,",
      "          borderColor: 'grey',",
      "          width: '100%',",
      "          minHeight: 100,",
      "          paddingVertical: 12,",
