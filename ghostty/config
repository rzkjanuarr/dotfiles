# ===================================================
# Ghostty config — dotfiles terpusat
# ===================================================

# ─── Font (ligatures ON) ───────────────────────────
# "JetBrainsMono Nerd Font" = varian DENGAN ligatures.
# (Hindari "JetBrainsMonoNL" — NL = No Ligatures.)
font-family = JetBrainsMono Nerd Font
font-size = 19

# Aktifkan ligatures + stylistic sets JetBrains Mono.
# calt & liga = contextual/standard ligatures (==> != >= dll).
font-feature = calt
font-feature = liga
font-feature = dlig
# ss01..ss20 = stylistic sets JetBrains Mono (opsional, rasa berbeda)
# font-feature = ss02

font-thicken = true

# ─── Theme (match Starship) ────────────────────────
theme = Catppuccin Mocha

# ─── Window / visual ───────────────────────────────
background-opacity = 0.85
background-blur-radius = 20
mouse-hide-while-typing = true
window-decoration = false
macos-option-as-alt = true
window-padding-x = 8
window-padding-y = 8

# ─── Clipboard ─────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# ─── Shell / behavior ──────────────────────────────
shell-integration = zsh
confirm-close-surface = false
quit-after-last-window-closed = true
window-inherit-working-directory = true
maximize = true
