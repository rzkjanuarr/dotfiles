# ===================================================
# Ghostty config — dotfiles terpusat
# ===================================================

# ─── Font (ligatures ON) ───────────────────────────
# "JetBrainsMono Nerd Font" = varian DENGAN ligatures.
# (Hindari "JetBrainsMonoNL" — NL = No Ligatures.)
font-family = JetBrainsMono Nerd Font
# Font kecil = "zoom out": makin banyak baris & kolom muat, ruang nvim lega.
# (dulu 19 — terlalu besar, sidebar + split bikin sempit)
font-size = 14

# Aktifkan ligatures + stylistic sets JetBrains Mono.
# calt & liga = contextual/standard ligatures (==> != >= dll).
font-feature = calt
font-feature = liga
font-feature = dlig
# ss01..ss20 = stylistic sets JetBrains Mono (opsional, rasa berbeda)
# font-feature = ss02

font-thicken = true

# ─── Theme (match Starship) ────────────────────────
theme = Catppuccin Mocha

# ─── Window / visual ───────────────────────────────
background-opacity = 0.80
background-blur-radius = 20
mouse-hide-while-typing = true
# Tab bar butuh titlebar. macos-titlebar-style=tabs bikin tab nyatu ke titlebar
# (look minimalis, tetap dapat multiple tab dengan ⌘T).
window-decoration = auto
macos-titlebar-style = tabs
macos-option-as-alt = true
window-padding-x = 8
window-padding-y = 8

# Buka window langsung besar biar nvim dapat ruang maksimal sejak awal.
# (alternatif: `maximize = true` untuk full-screen-tanpa-fullscreen)
window-width = 200
window-height = 50

# ─── Clipboard ─────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# ─── Tabs ──────────────────────────────────────────
# Tab native Ghostty pakai ⌘ (Cmd), tidak tabrakan dengan Ctrl (tmux/nvim):
#   ⌘T new tab · ⌘1..8 goto tab · ⌘9 last · ⌘Shift[ / ] prev/next · ⌘W close
# Matikan Ctrl+Tab default agar Ctrl bebas untuk tmux/nvim.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind

# ─── Shell / behavior ──────────────────────────────
shell-integration = zsh
confirm-close-surface = false
quit-after-last-window-closed = true
window-inherit-working-directory = true
maximize = true
